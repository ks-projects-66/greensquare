---
const tabs = [
  { id: 'context', label: 'Decision' },
  { id: 'interrogate', label: 'Interrogation' },
  { id: 'brief', label: 'Decision Brief' },
];
---
<section class="product-demo" data-product-demo aria-label="Illustrative Frame product demonstration">
  <div class="product-demo__topbar">
    <span class="product-demo__mark" aria-hidden="true"></span>
    <span>Frame</span>
    <span class="product-demo__status">Illustrative example</span>
  </div>

  <div class="product-demo__tabs" role="tablist" aria-label="Demonstration stage">
    {tabs.map((tab, index) => (
      <button
        type="button"
        role="tab"
        id={`demo-tab-${tab.id}`}
        aria-controls={`demo-panel-${tab.id}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        data-demo-tab={tab.id}
      >
        <span>{String(index + 1).padStart(2, '0')}</span>
        {tab.label}
      </button>
    ))}
  </div>

  <div class="product-demo__body">
    <div role="tabpanel" id="demo-panel-context" aria-labelledby="demo-tab-context" data-demo-panel="context">
      <div class="demo-grid demo-grid--context">
        <div>
          <p class="demo-label">The decision</p>
          <h3>Should we fund the national expansion now?</h3>
          <p>The current plan assumes demand, operating capacity and partner readiness can scale together within 12 months.</p>
        </div>
        <dl class="demo-facts">
          <div><dt>Decision owner</dt><dd>Executive team</dd></div>
          <div><dt>Required by</dt><dd>30 September</dd></div>
          <div><dt>Capital at risk</dt><dd>Material</dd></div>
          <div><dt>Initial confidence</dt><dd>Moderate</dd></div>
        </dl>
      </div>
    </div>

    <div role="tabpanel" id="demo-panel-interrogate" aria-labelledby="demo-tab-interrogate" data-demo-panel="interrogate" hidden>
      <div class="demo-question">
        <p class="demo-label">Frame asks before advising</p>
        <h3>Which evidence shows the operating model can absorb the first two regions without weakening the core business?</h3>
      </div>
      <div class="demo-evidence" role="group" aria-label="Evidence status">
        <div><span>Given</span><p>Two regions have signed expressions of interest.</p></div>
        <div><span>Derived</span><p>Break-even requires 68% utilisation by month nine.</p></div>
        <div><span>Inferred</span><p>Current managers can support both launches.</p></div>
        <div class="is-signal"><span>Unknown</span><p>Recruitment lead time in the second region.</p></div>
      </div>
    </div>

    <div role="tabpanel" id="demo-panel-brief" aria-labelledby="demo-tab-brief" data-demo-panel="brief" hidden>
      <div class="brief-head">
        <div>
          <p class="demo-label">Recommendation</p>
          <h3>Stage the expansion, do not fund the national rollout yet.</h3>
        </div>
        <div class="brief-confidence"><span>Confidence</span><strong>Moderate</strong></div>
      </div>

      <div class="brief-layout">
        <div>
          <p class="demo-label">Option priority</p>
          <div class="option-matrix" role="img" aria-label="Four options positioned by evidence confidence and strategic value. A staged two-region launch is highest on both measures.">
            <span class="axis axis--y">Strategic value</span>
            <span class="axis axis--x">Evidence confidence</span>
            <div class="matrix-quadrant"><span>Protect core</span></div>
            <div class="matrix-quadrant matrix-quadrant--best"><span>Stage two regions</span></div>
            <div class="matrix-quadrant"><span>Hold position</span></div>
            <div class="matrix-quadrant"><span>National rollout</span></div>
          </div>
        </div>
        <div class="brief-notes">
          <div><p class="demo-label">Why now</p><p>Test the economics before the next capital cycle.</p></div>
          <div><p class="demo-label">Critical risk</p><p>Management capacity is asserted, not evidenced.</p></div>
          <div><p class="demo-label">Decision condition</p><p>Approve region two only if recruitment lead time stays below eight weeks.</p></div>
          <div><p class="demo-label">Next review</p><p>Six weeks after region one begins trading.</p></div>
        </div>
      </div>
    </div>
  </div>

  <div class="product-demo__footer">
    <span>One decision, interrogated before recommendation</span>
    <span>Use the tabs to inspect the flow</span>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-demo]').forEach((demo) => {
    const tabs = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-demo-tab]'));
    const panels = Array.from(demo.querySelectorAll<HTMLElement>('[data-demo-panel]'));

    const activate = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const selected = tab.dataset.demoTab === id;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.demoPanel !== id; });
      const url = new URL(window.location.href);
      url.searchParams.set('demo', id);
      window.history.replaceState({}, '', url);
    };

    const requested = new URLSearchParams(window.location.search).get('demo');
    if (requested && tabs.some((tab) => tab.dataset.demoTab === requested)) activate(requested);

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab.dataset.demoTab ?? 'context'));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[next]?.dataset.demoTab ?? 'context', true);
      });
    });
  });
</script>

<style>
  .product-demo { border: 1px solid var(--v-ink); background: var(--v-paper); color: var(--v-ink); }
  .product-demo h3 { color: var(--v-ink); }
  .product-demo__topbar, .product-demo__footer { display: flex; align-items: center; gap: var(--v-3); padding: 14px var(--v-5); font-size: var(--vs-label); }
  .product-demo__topbar { border-bottom: 1px solid var(--v-ink); font-weight: 600; }
  .product-demo__mark { width: 14px; height: 14px; background: var(--v-green); }
  .product-demo__status { margin-left: auto; color: var(--v-ink-soft); font-weight: 400; }
  .product-demo__tabs { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--v-line); }
  .product-demo__tabs button { display: flex; align-items: center; gap: var(--v-3); min-height: 52px; padding: 0 var(--v-5); border: 0; border-right: 1px solid var(--v-line); background: var(--v-paper); color: var(--v-ink-soft); font: inherit; font-weight: 600; cursor: pointer; text-align: left; }
  .product-demo__tabs button:last-child { border-right: 0; }
  .product-demo__tabs button span { color: var(--v-ink-soft); font-size: var(--vs-label); font-variant-numeric: tabular-nums; }
  .product-demo__tabs button[aria-selected='true'] { background: var(--v-off); color: var(--v-green); box-shadow: inset 0 -3px 0 var(--v-green); }
  .product-demo__body { min-height: 480px; padding: clamp(1.5rem, 4vw, 3.25rem); }
  .product-demo__body [role='tabpanel'][hidden] { display: none; }
  .demo-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .demo-grid h3, .demo-question h3, .brief-head h3 { margin-top: var(--v-3); max-width: 23ch; font-size: clamp(1.55rem, 3vw, 2.6rem); line-height: 1.08; letter-spacing: -0.025em; }
  .demo-grid > div > p:last-child { margin-top: var(--v-5); color: var(--v-ink-soft); }
  .demo-label { margin: 0; color: var(--v-green); font-size: var(--vs-label); font-weight: 600; }
  .demo-facts { margin: 0; border-top: 2px solid var(--v-ink); }
  .demo-facts div { display: grid; grid-template-columns: 1fr 1fr; gap: var(--v-4); padding: var(--v-4) 0; border-bottom: 1px solid var(--v-line); }
  .demo-facts dt { color: var(--v-ink-soft); }
  .demo-facts dd { margin: 0; font-weight: 600; text-align: right; }
  .demo-question { max-width: 58rem; padding-bottom: var(--v-8); border-bottom: 1px solid var(--v-line); }
  .demo-evidence { margin-top: var(--v-6); }
  .demo-evidence > div { display: grid; grid-template-columns: 8rem 1fr; gap: var(--v-5); padding: var(--v-4) 0; border-bottom: 1px solid var(--v-line); }
  .demo-evidence span { font-size: var(--vs-label); font-weight: 600; }
  .demo-evidence p { margin: 0; }
  .demo-evidence .is-signal { border-left: 3px solid var(--v-green); padding-left: var(--v-4); }
  .brief-head { display: flex; justify-content: space-between; gap: var(--v-8); padding-bottom: var(--v-6); border-bottom: 1px solid var(--v-line); }
  .brief-confidence { min-width: 9rem; text-align: right; }
  .brief-confidence span { display: block; color: var(--v-ink-soft); font-size: var(--vs-label); }
  .brief-confidence strong { display: block; margin-top: var(--v-1); color: var(--v-green); }
  .brief-layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .85fr); gap: clamp(2rem, 5vw, 4.5rem); margin-top: var(--v-6); }
  .option-matrix { position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; min-height: 250px; margin: var(--v-5) 0 2.2rem 2.2rem; border-left: 1px solid var(--v-ink); border-bottom: 1px solid var(--v-ink); }
  .matrix-quadrant { display: flex; align-items: center; justify-content: center; min-height: 120px; padding: var(--v-4); border-top: 1px solid var(--v-line); border-right: 1px solid var(--v-line); color: var(--v-ink-soft); font-size: var(--vs-small); text-align: center; }
  .matrix-quadrant--best { background: var(--v-green); color: var(--v-cream); font-weight: 600; }
  .axis { position: absolute; color: var(--v-ink-soft); font-size: var(--vs-label); }
  .axis--x { left: 50%; bottom: -2rem; transform: translateX(-50%); }
  .axis--y { left: -2.3rem; top: 50%; writing-mode: vertical-rl; transform: translateY(-50%) rotate(180deg); }
  .brief-notes { border-top: 2px solid var(--v-ink); }
  .brief-notes > div { padding: var(--v-3) 0; border-bottom: 1px solid var(--v-line); }
  .brief-notes p:last-child { margin: var(--v-1) 0 0; color: var(--v-ink-soft); font-size: var(--vs-small); }
  .product-demo__footer { justify-content: space-between; border-top: 1px solid var(--v-line); color: var(--v-ink-soft); }
  @media (max-width: 760px) {
    .product-demo__tabs button { flex-direction: column; align-items: flex-start; justify-content: center; gap: 0; min-height: 62px; padding-inline: var(--v-3); }
    .product-demo__body { min-height: 0; }
    .demo-grid, .brief-layout { grid-template-columns: 1fr; }
    .brief-head { display: grid; }
    .brief-confidence { text-align: left; }
    .demo-evidence > div { grid-template-columns: 1fr; gap: var(--v-1); }
    .product-demo__footer { display: grid; }
  }
</style>
