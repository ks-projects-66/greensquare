---
import { withBase } from '../lib/paths';
import Analytics from '@vercel/analytics/astro';
import NavV2 from '../components/NavV2.astro';
import FooterV2 from '../components/FooterV2.astro';
import '../styles/global-v2.css';

export interface Props {
  title: string;
  description: string;
  current?: string;
  ogType?: string;
  noindex?: boolean;
}
const { title, description, current = '', ogType = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(withBase('/assets/og-image.png'), Astro.site).toString();
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <!-- Matches the sticky nav, which is what the browser chrome abuts, not the white page body. -->
    <meta name="theme-color" content="#10110f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GreenSquare AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={withBase('/assets/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase('/assets/apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Three faces, matching the design language and nothing more. IBM Plex Mono is gone:
         it was not in the guideline, and it was being asked for at weight 700 while only
         400 and 500 were loaded, so the browser synthesised the bold. Space Grotesk ships
         Semibold alone, which is the only weight the guideline gives it.

         The two faces load with different `display` values on purpose, which is why this
         is two requests rather than one.

         Reading text swaps. A paragraph reflowing costs a little shift and the reader
         genuinely wants the brand face for the text they spend their time in.

         Headings do not swap. Space Grotesk sets h1 and h2 only: a handful of large words
         under `text-wrap: balance`, where a small change in glyph advance moves a wrap
         point, changes the line count and moves everything below the heading. On /free/
         that measured 0.105 CLS against a 0.1 budget. The metric-matched fallbacks cannot
         reach it, because they correct the line box, not where a line breaks. With
         `optional` the heading either has the face from the first paint or keeps the
         fallback for that visit, and never moves either way. The face is still fetched and
         cached, so the second visit has it. -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Manrope:wght@600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600&display=optional"
      rel="stylesheet"
    />
  </head>
  <body class="v2 brand-site">
    <a class="skip-link" href="#main">Skip to content</a>
    <NavV2 current={current} />
    <main id="main">
      <slot />
    </main>
    <FooterV2 />
    <Analytics />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.v-reveal').forEach((el) => io.observe(el));

      const nav = document.querySelector('.v-nav');
      if (nav) {
        let ticking = false;
        const sync = () => { nav.classList.toggle('is-solid', window.scrollY > 12); ticking = false; };
        window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(sync); } }, { passive: true });
        sync();
      }

      const toggle = document.getElementById('v-nav-toggle');
      const drawer = document.getElementById('v-nav-drawer');
      const closeDrawer = (returnFocus = false) => {
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', 'Open menu');
        drawer?.classList.remove('is-open');
        if (returnFocus) toggle?.focus();
      };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
        drawer?.classList.toggle('is-open', !open);
        if (!open) drawer?.querySelector<HTMLElement>('a')?.focus();
      });
      drawer?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) closeDrawer();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && drawer?.classList.contains('is-open')) closeDrawer(true);
      });
      window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
        if (event.matches) closeDrawer();
      });
    </script>
  </body>
</html>
