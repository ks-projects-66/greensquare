---
import BaseLayoutV2 from './BaseLayoutV2.astro';
export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}
const { frontmatter } = Astro.props;
const title = frontmatter.title;
const description = frontmatter.description ?? 'Frame legal information.';
---
<BaseLayoutV2 title={`${title} | Frame`} description={description}>
  <section class="v-section">
    <div class="v-container v-container--narrow">
      <div class="v-prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayoutV2>
