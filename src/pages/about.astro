---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import { withBase } from '../lib/paths';

const principles = [
  ['Model-agnostic', 'The method should survive changes in model provider and capability.'],
  ['Evidence-led', 'Claims should be inspectable, bounded and revised when the evidence changes.'],
  ['Professionally accountable', 'The user remains responsible for the decision and its consequences.'],
  ['Truthful about limits', 'A useful boundary is better than an inflated promise.'],
];
---

<BaseLayoutV2
  title="About | GreenSquare AI"
  description="GreenSquare AI builds the professional judgement layer between intelligence and action."
  current="about"
>
  <div>
    <section class="about-hero v-hero v-hero--editorial">
      <div class="v-container">
        <h1>Build the judgement layer between intelligence and action.</h1>
      </div>
    </section>

    <section class="v-section">
      <div class="v-container premise-grid">
        <div>
          <h2>AI can generate more options, evidence and analysis than ever. That does not make the final judgement automatic.</h2>
          <p>GreenSquare AI exists to make consequential decisions more structured, interrogable and accountable.</p>
        </div>
      </div>
    </section>

    <section class="v-section">
      <div class="v-container">
        <h2>These four commitments do not change as the underlying model does.</h2>
        <div class="principles">
          {principles.map(([title, copy], index) => (
            <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{copy}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="v-section v-green">
      <div class="v-container focus-grid">
        <div>
          <h2>Make Frame Free genuinely useful. Earn the right to build Frame Pro.</h2>
        </div>
        <p>We are starting with an adaptive system for individual decisions, then learning what paid professional use should require before we define it.</p>
      </div>
    </section>

    <section class="v-section v-green">
      <div class="v-container closing">
        <h2>Bring a real decision.</h2>
        <div class="v-actions">
          <a class="v-btn v-btn--green" href={withBase('/free/')}>Try Frame Free</a>
          <a class="v-link" href="mailto:hello@greensquare.ai">Contact GreenSquare AI</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayoutV2>

<style>
  .about-hero h1 { max-width:16ch; }
  .focus-grid { display:grid; grid-template-columns:.45fr 1.55fr; gap:clamp(3rem,8vw,8rem); align-items:start; }
  .premise-grid { max-width:56rem; }
  .premise-grid h2 { max-width:24ch; }
  .premise-grid div > p { max-width:43rem; color:var(--v-ink-soft); font-size:1.1rem; }
  .principles { display:grid; grid-template-columns:repeat(2,1fr); margin-top:var(--v-5); border-top:1px solid var(--v-line); border-left:1px solid var(--v-line); }
  .principles article { min-height:17rem; padding:1.5rem; border-right:1px solid var(--v-line); border-bottom:1px solid var(--v-line); }
  .principles span { color:var(--v-green); font:600 var(--vs-label)/1 var(--vf-body); font-variant-numeric:tabular-nums; }
  .principles h3 { margin-top:4rem; }
  .principles p { color:var(--v-ink-soft); max-width:28rem; }
  .focus-grid > p { font-size:1.15rem; }
  .closing { display:flex; align-items:end; justify-content:space-between; gap:3rem; }
  @media (max-width:760px) {
    .focus-grid { grid-template-columns:1fr; }
    .principles { grid-template-columns:1fr; }
    .principles article { min-height:auto; }
    .principles h3 { margin-top:2.5rem; }
    .closing { align-items:flex-start; flex-direction:column; }
  }
</style>
