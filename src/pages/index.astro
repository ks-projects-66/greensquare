---
import { withBase } from '../lib/paths';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import EmailCaptureForm from '../components/EmailCaptureForm.tsx';
import FrameProcessAnimation from '../components/FrameProcessAnimation.astro';

const capabilities = [
  { label: 'Clarify', title: 'Define the decision before solving it', body: 'Frame identifies the mandate, decision owner, stakes and evidence needed before a recommendation can be credible.' },
  { label: 'Challenge', title: 'Expose assumptions and missing evidence', body: 'It separates what is known from what is inferred, tests contradictions and keeps uncertainty visible where it can still change the call.' },
  { label: 'Decide', title: 'Compare real options and define the path', body: 'It evaluates distinct choices consistently, recommends only when the evidence permits and carries decision conditions into action.' },
];
---
<BaseLayoutV2
  title="GreenSquare AI | Professional judgement for consequential decisions"
  description="Frame adds a disciplined professional judgement process to the AI you already use, from the first material question to an inspectable decision."
  current="home"
>
  <section class="home-hero v-hero v-hero--marketing">
    <div class="v-container">
      <h1 class="v-display">Make better use of capable AI when the decision matters.</h1>
      <p class="v-lead">
        Frame gives AI a disciplined process for consequential business decisions. It clarifies the real
        choice, interrogates the evidence and makes the recommendation easier to inspect before you act.
      </p>
      <div class="hero-actions">
        <a class="v-btn v-btn--green" href={withBase('/free/')}>Try Frame Free</a>
        <a class="v-link" href={withBase('/product/')}>See how Frame works</a>
      </div>
    </div>
  </section>

  <div class="v-container home-demo">
    <div class="v-hero__visual">
      <FrameProcessAnimation animated />
    </div>
  </div>

  <section class="v-section">
    <div class="v-container">
      <div class="section-intro">
        <h2 class="v-h2">A fluent answer is not the same as a sound decision.</h2>
        <p class="v-lead">AI can analyse and write at speed. It does not automatically know which question matters, which assumption carries the risk or what evidence should change the call.</p>
      </div>
      <div class="home-capabilities">
        {capabilities.map((item) => (
          <article>
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container product-intro">
      <div>
        <h2 class="v-h2">Start with the current beta.</h2>
      </div>
      <p class="v-lead">Frame Free is the current adaptive beta. Frame Pro is the paid plan that will follow and remains in development.</p>
    </div>
    <div class="v-container plan-grid">
      <article class="plan-card plan-card--available">
        <div><span class="plan-state">Available now</span><h3>Frame Free</h3></div>
        <p>An adaptive decision system you upload to a capable AI model. It moves from mandate and evidence through options, recommendation and proportionate execution.</p>
        <a class="v-btn v-btn--green" href={withBase('/free/')}>Try Frame Free</a>
      </article>
      <article class="plan-card">
        <div><span class="plan-state">In development</span><h3>Frame Pro</h3></div>
        <p>The future paid plan. Its scope, features and pricing will be published only when the product boundary is ready.</p>
        <a class="v-link" href={withBase('/product/#pro')}>View the product direction</a>
      </article>
    </div>
  </section>

  <section class="v-section research-strip">
    <div class="v-container research-strip__grid">
      <div>
        <h2 class="v-h2">Evidence with its boundary intact.</h2>
      </div>
      <div>
        <p class="v-lead">The published benchmark found a consistent change in process, not proof of better operator judgement. The protocol, findings, limitations and departures remain available for scrutiny.</p>
        <a class="v-link" href={withBase('/research/')}>Review the research</a>
      </div>
    </div>
  </section>

  <section class="home-cta v-section v-green">
    <div class="v-container home-cta__grid">
      <div>
        <h2 class="v-h2">Bring Frame to your next consequential decision.</h2>
        <p class="v-lead">Enter your email, confirm your address and receive Frame Free.</p>
      </div>
      <EmailCaptureForm client:visible />
    </div>
  </section>
</BaseLayoutV2>

<style>
  .hero-actions { display: flex; align-items: center; gap: var(--v-5); flex-wrap: wrap; margin-top: var(--v-8); }
  .home-hero { padding-bottom: var(--v-10); }
  .home-demo { padding-bottom: var(--v-section); }
  /* Was a two-column grid with the eyebrow filling the narrow .45fr label column.
     With the eyebrow removed the heading has nothing to sit beside, so this is a
     single measured block; h1/h2-to-lead spacing now comes from the shared rule
     in global-v2.css rather than a page-local override. */
  .section-intro { max-width: 50rem; }
  .home-capabilities { margin-top: var(--v-10); border-top: 2px solid var(--v-ink); }
  .home-capabilities article { display: grid; grid-template-columns: 7rem minmax(14rem, .75fr) minmax(18rem, 1.25fr); gap: var(--v-6); padding: var(--v-6) 0; border-bottom: 1px solid var(--v-line); }
  .home-capabilities article > span { color: var(--v-green); font-weight: 600; }
  .home-capabilities h3 { font-size: 1.25rem; }
  .home-capabilities p { color: var(--v-ink-soft); }
  .product-intro { display: grid; grid-template-columns: 1fr 1fr; gap: var(--v-10); align-items: end; }
  .product-intro .v-h2 { margin-top: var(--v-3); }
  .plan-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--v-5); margin-top: var(--v-10); }
  .plan-card { display: flex; flex-direction: column; align-items: flex-start; gap: var(--v-6); min-height: 330px; padding: var(--v-8); background: var(--v-paper); color: var(--v-ink); }
  .plan-card h3 { margin-top: var(--v-2); color: var(--v-ink); font-size: clamp(1.7rem, 3vw, 2.5rem); }
  .plan-card p { color: var(--v-ink-soft); }
  .plan-card > :last-child { margin-top: auto; }
  .plan-state { color: var(--v-ink-soft); font-size: var(--vs-label); font-weight: 600; }
  .research-strip__grid, .home-cta__grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 8rem); align-items: center; }
  .research-strip .v-link { display: inline-block; margin-top: var(--v-5); }
  .home-cta { padding-block: clamp(4rem, 7vw, 6rem); }
  @media (max-width: 900px) {
    .home-hero__grid, .product-intro, .research-strip__grid, .home-cta__grid { grid-template-columns: 1fr; }
    .home-hero__visual { min-width: 0; margin: 0 calc(var(--v-gutter) * -1); aspect-ratio: 16 / 9; }
    .plan-grid { grid-template-columns: 1fr; }
    .home-capabilities article { grid-template-columns: 5rem 1fr; }
    .home-capabilities article p { grid-column: 2; }
  }
  @media (max-width: 560px) {
    .home-hero__visual { aspect-ratio: 4 / 3; }
    .home-capabilities article { grid-template-columns: 1fr; gap: var(--v-3); }
    .home-capabilities article p { grid-column: auto; }
    .plan-card { min-height: 0; padding: var(--v-6); }
  }
</style>
