---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import ProductDemo from '../components/ProductDemo.astro';
import { withBase } from '../lib/paths';

const method = [
  ['Clarify', 'Define the decision, not just the topic.'],
  ['Inspect', 'Find the evidence and assumptions underneath it.'],
  ['Test', 'Challenge the logic before confidence hardens.'],
  ['Compare', 'Expose trade-offs between credible options.'],
  ['Decide', 'Form a recommendation with calibrated confidence.'],
  ['Execute', 'Name risks, owners and the next review point.'],
];
---

<BaseLayoutV2
  title="Frame | Professional judgement system"
  description="Frame is a professional judgement system that helps people frame, challenge and act on consequential decisions."
  current="product"
>
  <div>
    <section class="product-hero v-hero v-hero--marketing">
      <div class="v-container">
        <h1>Better intelligence is not enough. You need better judgement.</h1>
        <p class="v-lead">Frame is the decision layer between what an AI can generate and what a professional can responsibly act on.</p>
        <div class="v-actions">
          <a class="v-btn v-btn--green" href={withBase('/free/')}>Try Frame Free</a>
          <a class="v-link" href="#demo">Explore the product</a>
        </div>
      </div>
    </section>

    <section class="v-section">
      <div class="v-container method-grid">
        <div class="method-intro">
          <h2>From a messy situation to a defensible next move.</h2>
        </div>
        <ol>
          {method.map(([title, copy], index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{copy}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="v-section" id="demo">
      <div class="v-container">
        <div class="demo-head">
          <h2>See the decision change as the evidence changes.</h2>
          <p>Move through an illustrative decision, the adaptive interrogation and the resulting Decision Brief.</p>
        </div>
        <ProductDemo />
      </div>
    </section>

    <section class="v-section">
      <div class="v-container boundary">
        <h2>The model contributes intelligence. Frame structures judgement. You remain accountable.</h2>
      </div>
    </section>

    <section class="v-section" id="plans">
      <div class="v-container">
        <div class="plans-head">
          <h2>Start free. Move up when the work demands it.</h2>
        </div>
        <div class="plans">
          <article>
            <div class="plan-status">Available</div>
            <h3>Frame Free</h3>
            <p>The adaptive decision system for individual use during beta.</p>
            <a class="v-btn v-btn--green" href={withBase('/free/')}>Try Frame Free</a>
          </article>
          <article id="pro">
            <div class="plan-status muted">In development</div>
            <h3>Frame Pro</h3>
            <p>The paid plan that will follow. Scope and pricing will be announced when they are ready.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="v-section">
      <div class="v-container research-callout">
        <div>
          <h2>We separate what the evidence shows from what the product promises.</h2>
        </div>
        <a class="v-link" href={withBase('/research/')}>Read the research record</a>
      </div>
    </section>
  </div>
</BaseLayoutV2>

<style>
  h1 { max-width:19ch; }
  .v-lead { max-width:40rem; }
  .method-grid { display:grid; grid-template-columns:.85fr 1.15fr; gap:clamp(3rem,9vw,9rem); align-items:start; }
  .method-intro { position:sticky; top:8rem; }
  .method-grid ol { list-style:none; margin:0; padding:0; }
  .method-grid li { display:grid; grid-template-columns:3.5rem 1fr; gap:1rem; padding:1.4rem 0; border-top:1px solid var(--v-line); }
  .method-grid li > span { color:var(--v-green); font:600 var(--vs-label)/1 var(--vf-body); font-variant-numeric:tabular-nums; padding-top:.35rem; }
  .method-grid h3, .method-grid p { margin:0; }
  .method-grid p { color:var(--v-ink-soft); margin-top:.35rem; }
  .demo-head { max-width:47rem; margin-bottom:3rem; }
  .demo-head > p:last-child { color:var(--v-ink-soft); }
  .boundary { max-width:62rem; }
  .plans-head { max-width:45rem; margin-bottom:3rem; }
  .plans { display:grid; grid-template-columns:repeat(2,1fr); border:1px solid var(--v-line); }
  .plans article { padding:clamp(1.5rem,4vw,3rem); min-height:24rem; display:flex; flex-direction:column; align-items:flex-start; }
  .plans article + article { border-left:1px solid var(--v-line); }
  .plans p { color:var(--v-ink-soft); max-width:29rem; }
  .plans .v-btn { margin-top:auto; }
  .plan-status { font:600 var(--vs-label)/1 var(--vf-body); color:var(--v-green); margin-bottom:4rem; }
  .plan-status.muted { color:var(--v-ink-soft); }
  .research-callout { display:flex; justify-content:space-between; gap:3rem; align-items:end; }
  .research-callout h2 { max-width:20ch; }
  @media (max-width:760px) {
    .method-grid { grid-template-columns:1fr; }
    .method-intro { position:static; }
    .plans { grid-template-columns:1fr; }
    .plans article { min-height:20rem; }
    .plans article + article { border-left:0; border-top:1px solid var(--v-line); }
    .research-callout { align-items:flex-start; flex-direction:column; }
  }
</style>
